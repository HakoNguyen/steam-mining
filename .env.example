# =============================================================================

# LOCAL ENVIRONMENT CONFIGURATION (.env) - DO NOT COMMIT TO GIT

# STEAM DATA WAREHOUSE ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to '.env' and adjust values for local development.

# =============================================================================

# 1. PostgreSQL Data Warehouse Configuration
POSTGRES_USER=admin
POSTGRES_PASSWORD=adminpassword123
POSTGRES_DB=steam_dwh
# Địa chỉ khi chạy script trên máy (VS Code cũng nạp file này vào terminal). Trong Docker,
# docker-compose.yml tự đặt postgres-dwh:5432 và minio-datalake:9000 nên không cần sửa ở đây.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433



# 2. MinIO S3 Raw Data Lake Configuration
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=adminpassword123
MINIO_ENDPOINT=localhost:9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=raw-steam-data

# 3. Apache Airflow Configuration
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__FERNET_KEY=46BKJgYlLwV8W0_pAKo5i3WzAZ0_J8x0v1Z23456789=

# 4. Metabase BI Configuration
METABASE_DB_TYPE=postgres
METABASE_DB_NAME=metabase_db
METABASE_PORT=3000
# Metabase > Admin settings > Authentication > API keys (scripts/metabase_dashboard.py và Streamlit dùng)
METABASE_API_KEY=
# Để trống: scripts/metabase_dashboard.py tự sinh khi bật nhúng dashboard
METABASE_EMBED_SECRET=

# 5. Streamlit Dashboard Configuration
STREAMLIT_PORT=8501

# 6. AI Copilot
# User Postgres chỉ-đọc (scripts/create_copilot_role.sql)
COPILOT_DB_USER=copilot_ro
COPILOT_DB_PASSWORD=change_me
# Mô hình mặc định khi mở trang Copilot: gemini | openrouter | anthropic (đổi được ngay trên giao diện)
COPILOT_PROVIDER=gemini
# Gemini (gói miễn phí): https://aistudio.google.com > Get API key
GEMINI_API_KEY=
# DeepSeek V4 qua OpenRouter (trả phí theo credit): https://openrouter.ai > Keys
OPENROUTER_API_KEY=
# Claude (tùy chọn)
ANTHROPIC_API_KEY=
# Tùy chọn: đổi mô hình của từng nhà cung cấp
# COPILOT_GEMINI_MODEL=gemini-flash-lite-latest
# COPILOT_OPENROUTER_MODEL=deepseek/deepseek-v4-flash
