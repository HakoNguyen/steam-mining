# ==========================================
# 3. Data Engineering, Lake & Staging Data
# ==========================================
# Ignore local SQLite databases, CSV dumps, JSON temporary crawls
 
*.db
*.sqlite
*.sqlite3
*.csv
*.parquet
*.json
!dashboard/package.json
!dags/config/*.json

steam_sample_data.json

# Keep sample data schema files if explicitly tracked
steam_sample_data.json

# MinIO data volume if mounted locally
minio_data/
postgres_data/

# ==========================================
# 4. Apache Airflow System Files
# ==========================================
airflow.cfg
airflow.db
airflow-webserver.pid
logs/
plugins/__pycache__/
*.log

# SQLMesh (cache biên dịch model, sinh lại được)
sqlmesh/.cache/

# Kết quả mining (chỉ số, model, hình, CSV ~3 MB) được commit để máy khác mở trang Khai phá dữ liệu
# mà không phải chạy lại 5 script; chạy lại script hằng tuần rồi commit để cập nhật (README bước 7)
!mining/outputs/*.csv
!mining/outputs/*.json

# ==========================================
